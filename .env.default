SUPPLY_PACKAGE_NAME=fi.sykero.trackworktime
# SUPPLY_JSON_KEY_DATA is injected at invocation time by the Makefile, which
# decrypts fastlane/sykero-software-682627ee0658.json.gpg in memory. The plaintext
# JSON key is never written to disk. Do NOT set SUPPLY_JSON_KEY here.
SUPPLY_TRACK=internal
SUPPLY_SKIP_UPLOAD_APK=true
SUPPLY_SKIP_UPLOAD_AAB=true
SUPPLY_SKIP_UPLOAD_CHANGELOGS=true
SUPPLY_SKIP_UPLOAD_IMAGES=true
SUPPLY_SKIP_UPLOAD_SCREENSHOTS=true
